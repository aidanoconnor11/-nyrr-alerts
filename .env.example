# Comma-separated event pages to monitor even when NYRR's directory is unavailable.
# NYRR_EVENT_URLS=https://events.nyrr.org/nyrr-midnight-run-volunteers

# Leave enabled to discover current event pages automatically.
NYRR_DIRECTORY_URL=https://www.nyrr.org/getinvolved/volunteeropportunities
NYRR_OPEN_STATUSES=AVL,MED

# SMTP example: Gmail requires an app password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=replace-with-app-password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com

# Use an absolute path when scheduled by cron/launchd.
# NYRR_STATE_FILE=/Users/you/nyrr-alerts/state.json
